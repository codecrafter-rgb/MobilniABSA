<View>
  <Header value="Telefon: $phone" style="padding: 10px 16px; border: 2px solid transparent; border-radius: 5px" size="4"/>

  <View style="display: flex; align-items: center; gap: 16px; margin-top: 1.2em; padding: 0px 16px; border-radius: 5px; border: 2px solid #423C6E;">
    <Header value="Da li je RECENZIJA?" style="margin: 0; white-space: nowrap;"/>
    <Choices name="review_status" toName="comment" choice="single" showInLine="true" required="true">
      <Choice value="DA" selected="true" hotkey="y"/>
      <Choice value="NE" hotkey="n"/>
    </Choices>
  </View>

  <View style="padding: 16px; border: 2px solid #2E7D4A; border-radius: 8px; margin: 1.2em 0; box-shadow: 0 4px 12px rgba(46, 125, 74, 0.15);">
    <Text name="comment" value="$comment"/>
  </View>

  <View visibleWhen="choice-selected" whenTagName="review_status" whenChoiceValue="DA">
    
    <Header value="Eksplicitni aspekti" size="5"/>
    <Labels name="categories" toName="comment">
      <Label value="Baterija" background="#FFD700" hotkey="1"/>
      <Label value="Kamera" background="#FF69B4" hotkey="2"/>
      <Label value="Ekran" background="#1E90FF" hotkey="3"/>
      <Label value="Memorija" background="#9370DB" hotkey="4"/>
      <Label value="Zvučnici" background="#20B2AA" hotkey="5"/>
      <Label value="Izgled" background="#FFA07A" hotkey="6"/>
      <Label value="Hardver" background="#4682B4" hotkey="7"/>
      <Label value="Softver" background="#32CD32" hotkey="8"/>
      <Label value="Cena" background="#FF8C00" hotkey="9"/>
      <Label value="Performanse" background="#35118A" hotkey="0"/>
      <Label value="Opšta ocena" background="#A9A9A9" hotkey="-"/>
    </Labels>

    <Header value="SENTIMENT" size="4"/>
    <Choices name="sentiment" toName="comment" showInLine="true" perRegion="true" required="true">
      <Choice value="Pozitivan" hotkey="a"/>
      <Choice value="Negativan" hotkey="d"/>
      <Choice value="Neutralan" hotkey="s"/>
      <Choice value="Konflikt" hotkey="w"/>
    </Choices>

    <Header value="Implicitni aspekti" size="5"/>
    <Taxonomy name="implicit_aspects" toName="comment" leafsOnly="true" showFullPath="true">

      <Choice value="Baterija">
        <Choice value="Pozitivan"/>
        <Choice value="Negativan"/>
        <Choice value="Neutralan"/>
        <Choice value="Konflikt"/>
      </Choice>

      <Choice value="Kamera">
        <Choice value="Pozitivan"/>
        <Choice value="Negativan"/>
        <Choice value="Neutralan"/>
        <Choice value="Konflikt"/>
      </Choice>

      <Choice value="Ekran">
        <Choice value="Pozitivan"/>
        <Choice value="Negativan"/>
        <Choice value="Neutralan"/>
        <Choice value="Konflikt"/>
      </Choice>

      <Choice value="Memorija">
        <Choice value="Pozitivan"/>
        <Choice value="Negativan"/>
        <Choice value="Neutralan"/>
        <Choice value="Konflikt"/>
      </Choice>

      <Choice value="Zvučnici">
        <Choice value="Pozitivan"/>
        <Choice value="Negativan"/>
        <Choice value="Neutralan"/>
        <Choice value="Konflikt"/>
      </Choice>

      <Choice value="Izgled">
        <Choice value="Pozitivan"/>
        <Choice value="Negativan"/>
        <Choice value="Neutralan"/>
        <Choice value="Konflikt"/>
      </Choice>

      <Choice value="Hardver">
        <Choice value="Pozitivan"/>
        <Choice value="Negativan"/>
        <Choice value="Neutralan"/>
        <Choice value="Konflikt"/>
      </Choice>

      <Choice value="Softver">
        <Choice value="Pozitivan"/>
        <Choice value="Negativan"/>
        <Choice value="Neutralan"/>
        <Choice value="Konflikt"/>
      </Choice>

      <Choice value="Cena">
        <Choice value="Pozitivan"/>
        <Choice value="Negativan"/>
        <Choice value="Neutralan"/>
        <Choice value="Konflikt"/>
      </Choice>

      <Choice value="Performanse">
        <Choice value="Pozitivan"/>
        <Choice value="Negativan"/>
        <Choice value="Neutralan"/>
        <Choice value="Konflikt"/>
      </Choice>

      <Choice value="Opšta ocena">
        <Choice value="Pozitivan"/>
        <Choice value="Negativan"/>
        <Choice value="Neutralan"/>
        <Choice value="Konflikt"/>
      </Choice>

    </Taxonomy>

  </View>
</View>