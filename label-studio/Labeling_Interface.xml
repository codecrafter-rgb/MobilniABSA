<View>
  <Header value="Anotiraj sve aspekte u datoj recenziji" size="3"/>
  <Header value="Telefon: $phone" size="4"/>
  <Labels name="sentimenti_aspekata" toName="comment">
    <Label value="Pozitivan" background="#0cf3b4"/>
    <Label value="Negativan" background="#f93a06"/>
    <Label value="Neutralan" background="#6a00ff"/>
    <Label value="Konflikt" background="#efff00"/>
    </Labels>
  
  <View style="margin-top: 1em;"/>
  
  <Text name="comment" value="$comment"/>
  
  <View style="margin-top: 4em;"/>
  
